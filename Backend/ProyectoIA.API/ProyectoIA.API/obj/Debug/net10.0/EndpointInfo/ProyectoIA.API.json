{
  "openapi": "3.0.1",
  "info": {
    "title": "ProyectoIA API",
    "version": "v1"
  },
  "paths": {
    "/api/Chat": {
      "post": {
        "tags": [
          "Chat"
        ],
        "requestBody": {
          "content": {
